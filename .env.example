# Copy to .env. Never put this key in VITE_* or frontend code.
OPENAI_API_KEY=
# Set to a vision-capable model available to your API project.
OPENAI_MODEL=gpt-4.1-mini
PORT=3210
HOST=0.0.0.0
# Only needed behind an HTTPS reverse proxy, e.g. https://study.example.com
PUBLIC_ORIGIN=
# Optional: a long access code for pairing your tablet; otherwise generated in data/access-token.
STUDY_ACCESS_TOKEN=
# Optional: full path to soffice.exe. Windows PowerPoint is also detected.
LIBREOFFICE_PATH=
